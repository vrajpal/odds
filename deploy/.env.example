# Tailscale auth key (OPTIONAL): admin console > Settings > Keys > Generate auth key.
# Recommended: Reusable OFF, Ephemeral OFF, Pre-approved ON, tag it if you use ACL tags.
# Leave unset to enroll interactively instead: bring the stack up and approve
# the login URL printed by `docker compose logs tailscale`.
#TS_AUTHKEY=tskey-auth-REPLACE-ME

# The Odds API key (metered; used only by the nfl-collect one-shot service)
THE_ODDS_API_KEY=REPLACE-ME
