# Tailscale auth key (OPTIONAL): admin console > Settings > Keys > Generate auth key.
# Recommended: Reusable OFF, Ephemeral OFF, Pre-approved ON, tag it if you use ACL tags.
# Leave unset to enroll interactively instead: bring the stack up and approve
# the login URL printed by `docker compose logs tailscale`.
#TS_AUTHKEY=tskey-auth-REPLACE-ME

# The Odds API key (metered; used only by the nfl-collect one-shot service)
THE_ODDS_API_KEY=REPLACE-ME

# The three-person group, comma-separated. Order matters: it defines the
# weekly captain rotation (week 1 -> first name, week 2 -> second, ...).
CONTEST_MEMBERS=player1,player2,player3

# --- Public access via Cloudflare (optional, D-026) ---
# Tunnel token: Zero Trust > Networks > Tunnels > Create > Cloudflared,
# copy the token from the install command. Enables `--profile public`.
#CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# Access email -> member identity mapping. When Cloudflare Access forwards an
# authenticated email that maps here, the UI locks to that member and the API
# rejects acting as anyone else. Format: email:Member pairs, comma-separated.
#CONTEST_MEMBER_EMAILS=vijai@example.com:Vijai,neem@example.com:Neem,mike@example.com:Mike
